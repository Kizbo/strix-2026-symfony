{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(ddev exec *)",
      "Bash(ddev describe)",
      "Bash(curl *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bin/lite-time *)",
      "Bash(bin/lite-time)",
      "Bash(bin/lite-lock *)",
      "Bash(cmp *)",
      "Bash(cp docs/specs/* tests/Fixtures/*)",
      "Bash(mkdir -p tests/Fixtures)"
    ],
    "ask": [
      "Bash(ddev composer require *)",
      "Bash(git restore *)",
      "Bash(git reset *)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Bash(git push *)",
      "Bash(git commit --no-verify *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-tests.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timing-skills.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timing.sh"
          }
        ]
      }
    ]
  }
}