#!/usr/bin/env bash
# Usage: bin/sign-webhook <body-file> [secret]
# Prints the X-Webhook-Signature value: hex HMAC-SHA256 of the raw file bytes.
set -euo pipefail
file="${1:?Usage: bin/sign-webhook <body-file> [secret]}"
secret="${2:-${WEBHOOK_SECRET:-change_me}}"
openssl dgst -sha256 -hmac "$secret" < "$file" | awk '{print $NF}'
